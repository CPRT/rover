{
  "name": "CPRT Dev Container (On Rover)",

  "image": "cprtsoftware/rover:dev",

  "runArgs": [
    "--network=host",
    "--privileged",
    "--volume=/dev/v4l/:/dev/v4l/",
    "--volume=/dev/serial/by-id:/dev/serial/by-id",
    "--volume=/sys:/sys",
    "--volume=/etc/timezone:/etc/timezone",
    "--volume=/tmp/argus_socket:/tmp/argus_socket",
    "--volume=/usr/local/zed:/usr/local/zed",
    "--runtime=nvidia",
    "--env", "NVIDIA_DISABLE_REQUIRE=true",
    "--gpus=all",
    "--ipc=host",
    "--group-add=video",
    "--group-add=render",
    "--group-add=systemd-journal",
    "--group-add=dialout",
    "--group-add=984"
  ],
  "mounts": [
    "source=${env:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
    "source=${env:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  },
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "remoteEnv": {
    "USER": "ubuntu"
  },

  // Usual extras (optional)
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [ "ms-vscode.cpptools", "ms-azuretools.vscode-docker" ]
    }
  },
  "postCreateCommand": "source /opt/ros/jazzy/setup.bash"
}