{
  "name": "CPRT Dev Container",

  "image": "cprtsoftware/rover:dev",

  "runArgs": [
    "--network=host",
    "--privileged",
    "--volume=/dev/v4l/by-id:/dev/v4l/by-id",
    "--volume=/dev/serial/by-id:/dev/serial/by-id",
    "--volume=/dev/input:/dev/input",
    "--volume=/sys:/sys",
    "--volume=/etc/timezone:/etc/timezone",
    "--ipc=host",
    "--group-add=video",
    "--group-add=render",
    "--group-add=dialout",
    "--group-add=input",
    "--volume=/dev/ttyUSB0:/dev/ttyUSB0"
  ],
  "mounts": [
    "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${env:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  },
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "remoteEnv": {
    "USER": "ubuntu"
  },

  // Usual extras (optional)
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [ "ms-vscode.cpptools", "ms-azuretools.vscode-docker" ]
    }
  },
"postCreateCommand": "echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc"
}