<?xml version="1.0"?>
<package format="3">
  <name>gimbal_control</name><version>0.1.0</version>
  <description>ROS 2 control camera gimbal controller and Maestro servo hardware.</description>
  <maintainer email="software@cprt.ca">CPRT</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend><depend>hardware_interface</depend>
  <depend>pluginlib</depend><depend>rclcpp</depend><depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend><depend>geometry_msgs</depend><depend>std_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend><test_depend>sensor_msgs</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>ament_index_python</test_depend><test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
