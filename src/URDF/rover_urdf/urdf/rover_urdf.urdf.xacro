<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_urdf">
  <xacro:arg name="use_arm" default="true"/>
  <xacro:arg name="use_drive" default="true"/>
  <xacro:arg name="use_gimbal" default="true"/>
  <xacro:arg name="gimbal_mock_hardware" default="false"/>
  <xacro:arg name="gimbal_serial_port" default="/dev/serial/by-id/usb-Pololu_Corporation_Pololu_Mini_Maestro_12-Channel_USB_Servo_Controller_00460938-if00"/>
  <xacro:arg name="gimbal_mount_xyz" default="0 0 0"/>
  <xacro:arg name="gimbal_mount_rpy" default="0 0 0"/>
  <xacro:arg name="mast_camera_xyz" default="0 0 0"/>
  <xacro:arg name="mast_camera_rpy" default="0 0 0"/>
  <link name="base_link"/>
  <xacro:if value="$(arg use_gimbal)">
    <xacro:include filename="$(find rover_urdf)/urdf/gimbal_urdf.xacro"/>
    <xacro:include filename="$(find rover_urdf)/urdf/gimbal_urdf.ros2_control.xacro"/>
    <xacro:gimbal_urdf mount_xyz="$(arg gimbal_mount_xyz)" mount_rpy="$(arg gimbal_mount_rpy)"
      mast_xyz="$(arg mast_camera_xyz)" mast_rpy="$(arg mast_camera_rpy)"/>
    <xacro:gimbal_ros2_control mock="$(arg gimbal_mock_hardware)" serial_port="$(arg gimbal_serial_port)"/>
  </xacro:if>

  <xacro:if value="$(arg use_arm)">
    <!-- Arm geometry -->
    <xacro:include filename="$(find rover_urdf)/urdf/arm_urdf.xacro" />
    <xacro:arm_urdf />

    <!-- Arm ros2_control -->
    <xacro:include filename="$(find rover_urdf)/urdf/arm_urdf.ros2_control.xacro" />
    <xacro:arm_urdf_ros2_control name="ArmSystem"/>

    <!-- Link to base_link -->
    <joint name="base_link_to_arm_base" type="fixed">
      <parent link="base_link"/>
      <child link="Link_1"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg use_drive)">
    <!-- Chassis ... -->
    <xacro:include filename="$(find rover_urdf)/urdf/chassis_urdf.xacro" />
    <xacro:chassis_urdf />

      <!-- Chassis ros2_control -->
    <xacro:include filename="$(find rover_urdf)/urdf/chassis_urdf.ros2_control.xacro" />
    <xacro:chassis_urdf_ros2_control name="ChassisSystem"/>

    <joint name="base_link_to_chassis" type="fixed">
      <parent link="base_link"/>
      <child link="Frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>


</robot>
